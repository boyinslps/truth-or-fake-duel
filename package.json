{
  "name": "zhenjia-duel",
  "version": "1.0.0",
  "description": "真假對決：給國小學生的 1v1 線上媒體識讀卡牌遊戲（React + three.js + Socket.IO）",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts --port 3001\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "validate": "tsx server/validate-cli.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "media-literacy",
    "card-game",
    "education",
    "threejs",
    "socket.io",
    "react",
    "typescript"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "express": "^5.2.1",
    "lucide": "^1.49.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "author": "資訊老師黃博胤"
}
